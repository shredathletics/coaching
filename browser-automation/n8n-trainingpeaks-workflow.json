{
  "name": "TrainingPeaks Client Sync",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "triggerAtHour": 6
            }
          ]
        }
      },
      "id": "schedule-trigger",
      "name": "Daily 6am Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [240, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:3001/trainingpeaks/full",
        "options": {
          "timeout": 120000
        }
      },
      "id": "fetch-trainingpeaks",
      "name": "Fetch TrainingPeaks Data",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.success }}",
              "value2": true
            }
          ]
        }
      },
      "id": "check-success",
      "name": "Check Success",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [680, 300]
    },
    {
      "parameters": {
        "jsCode": "// Format athlete data for Telegram message\nconst athletes = $input.first().json.data.athletes;\nconst overview = $input.first().json.data.overview;\n\nlet message = `📊 *TrainingPeaks Daily Report*\\n`;\nmessage += `📅 ${new Date().toLocaleDateString()}\\n\\n`;\n\nif (athletes && athletes.length > 0) {\n  message += `👥 *Athletes (${athletes.length}):*\\n`;\n  for (const athlete of athletes) {\n    message += `• ${athlete.name}`;\n    if (athlete.complianceScore) {\n      message += ` - Compliance: ${athlete.complianceScore}`;\n    }\n    if (athlete.lastActivity) {\n      message += ` - Last: ${athlete.lastActivity}`;\n    }\n    message += `\\n`;\n  }\n} else {\n  message += `_No athlete data extracted_\\n`;\n}\n\nif (overview && overview.summary) {\n  message += `\\n📋 *Summary:*\\n${overview.summary}`;\n}\n\nreturn [{ json: { message } }];"
      },
      "id": "format-message",
      "name": "Format for Telegram",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [900, 200]
    },
    {
      "parameters": {
        "chatId": "YOUR_TELEGRAM_CHAT_ID",
        "text": "={{ $json.message }}",
        "additionalFields": {
          "parse_mode": "Markdown"
        }
      },
      "id": "send-telegram",
      "name": "Send to Telegram",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [1120, 200],
      "credentials": {
        "telegramApi": {
          "id": "YOUR_TELEGRAM_CREDENTIAL_ID",
          "name": "Telegram Bot"
        }
      }
    },
    {
      "parameters": {
        "chatId": "YOUR_TELEGRAM_CHAT_ID",
        "text": "⚠️ *TrainingPeaks Sync Failed*\n\nError: {{ $json.error }}\n\nCheck the browser automation server logs.",
        "additionalFields": {
          "parse_mode": "Markdown"
        }
      },
      "id": "send-error",
      "name": "Send Error Alert",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [900, 400],
      "credentials": {
        "telegramApi": {
          "id": "YOUR_TELEGRAM_CREDENTIAL_ID",
          "name": "Telegram Bot"
        }
      }
    }
  ],
  "connections": {
    "Daily 6am Trigger": {
      "main": [
        [
          {
            "node": "Fetch TrainingPeaks Data",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch TrainingPeaks Data": {
      "main": [
        [
          {
            "node": "Check Success",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check Success": {
      "main": [
        [
          {
            "node": "Format for Telegram",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Send Error Alert",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Format for Telegram": {
      "main": [
        [
          {
            "node": "Send to Telegram",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "tags": [
    {
      "name": "coaching"
    },
    {
      "name": "trainingpeaks"
    }
  ]
}
